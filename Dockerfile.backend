# =============================================================================
# BJJ-BetSports Backend - Multi-stage Dockerfile
# Stage 1: Build dependencies
# Stage 2: Production runtime with gunicorn + uvicorn workers
# =============================================================================

# ---- Stage 1: Builder ----
FROM python:3.11-slim AS builder

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend

WORKDIR /app

# Install build dependencies
RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    g++ \
    libffi-dev \
    && rm -rf /var/lib/apt/lists/*

# Install Python dependencies
COPY backend/requirements-prod.txt ./backend/
RUN pip install --no-cache-dir -r backend/requirements-prod.txt

# Copy application code
COPY backend ./backend


# ---- Stage 2: Production Runtime ----
FROM python:3.11-slim

ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONPATH=/app/backend

WORKDIR /app

# Install runtime dependencies only (curl for healthchecks)
RUN apt-get update && apt-get install -y --no-install-recommends curl && rm -rf /var/lib/apt/lists/*

# Copy installed packages and application from builder
COPY --from=builder /usr/local/lib/python3.11/site-packages /usr/local/lib/python3.11/site-packages
COPY --from=builder /usr/local/bin /usr/local/bin
COPY --from=builder /app/backend /app/backend
COPY run_dev_pipeline.sh ./

EXPOSE 8000

WORKDIR /app/backend

# Production: gunicorn with uvicorn workers (no --reload)
# Workers = 2 * CPU cores + 1 is a common heuristic; override via WEB_CONCURRENCY env
CMD ["gunicorn", "src.api.main:app", \
     "-w", "4", \
     "-k", "uvicorn.workers.UvicornWorker", \
     "--bind", "0.0.0.0:8000", \
     "--access-logfile", "-", \
     "--error-logfile", "-", \
     "--log-level", "info"]